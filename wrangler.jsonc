// Dump v2: one Worker serves the app, the API, and the reminder cron.
{
  "name": "dump",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // The app files in public/ are bundled into the Worker as text/bytes (worker/static.js).
  "rules": [
    { "type": "Text", "globs": ["../public/*.html", "../public/*.js", "../public/*.css", "../public/*.json"], "fallthrough": true },
    { "type": "Data", "globs": ["../public/*.png"], "fallthrough": true }
  ],
  "d1_databases": [
    // Paste the database_id that `npx wrangler d1 create dump` prints.
    { "binding": "DB", "database_name": "dump", "database_id": "c93be9ea-543d-49fb-9223-42fd2f883bd4", "migrations_dir": "migrations" }
  ],
  // Every 5 minutes. All the quiet-hours / daily-cap logic lives in worker/index.js.
  "triggers": { "crons": ["*/5 * * * *"] },
  "routes": [{ "pattern": "dump.bixjohnson.com", "custom_domain": true }],
  "vars": { "VAPID_SUBJECT": "https://dump.bixjohnson.com" },
  "observability": { "enabled": true }
}
